# Used ONLY by scripts/test_smtp.py (n8n keeps its own credentials in its UI).
# Copy to .env and fill in. Never commit .env.
SMTP_HOST=smtp.gmail.com
# 465 = implicit SSL  |  587 = STARTTLS
SMTP_PORT=465
SMTP_USER=you@gmail.com
# Google App Password (16 chars). Requires 2-Step Verification on the account.
SMTP_APP_PASSWORD=
FROM_NAME=Your Company
TEST_RECIPIENT=your.other.inbox@example.com
